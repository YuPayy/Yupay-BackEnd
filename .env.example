# Python OCR service — environment template
# Copy to .env and fill in real values. NEVER commit .env.

# Backend TS callback URL (where OCR sends extracted data)
# Local dev: http://localhost:3000/api/v1/nota
TS_BACKEND_URL=http://localhost:3000/api/v1/nota

# Shared secret for OCR -> Backend authentication
# Generate with: openssl rand -hex 32
INTERNAL_AUTH_TOKEN=replace_me_with_secure_random_string

# Optional: override server bind
OCR_HOST=0.0.0.0
OCR_PORT=5057

# Gmail SMTP (untuk OTP & notifikasi)
# EMAIL_USER: alamat Gmail pengirim
# EMAIL_PASS: App Password (bukan password akun), generate di myaccount.google.com → App passwords
EMAIL_USER=your-email@gmail.com
EMAIL_PASS=your-app-password

# Cron jobs (Issue #28)
# Set true untuk enable debt reminder harian di production
ENABLE_CRON=false
CRON_TIMEZONE=Asia/Jakarta
